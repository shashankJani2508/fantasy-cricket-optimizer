# Copy to .env (never commit .env). Names only; values are set in Vercel's Environment Variables.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CRICKETDATA_API_KEY=
# offline (default for development and tests) | cache_only | live (production)
CRICKETDATA_MODE=offline
# Optional: leave empty for no passcode (the link is private to Aryan)
APP_PASSCODE=
CRON_SECRET=
